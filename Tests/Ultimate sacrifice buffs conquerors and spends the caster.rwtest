rwtest 1
test "Ultimate sacrifice buffs conquerors and spends the caster" project="Apex Mechanoids" group="Ability" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Conqueror_DMR at 0,0 faction=player name="Caster"
spawn Pawn:APM_Mech_Conqueror_AR at 4,0 faction=player name="Near"
spawn Pawn:APM_Mech_Conqueror_SMG at 15,0 faction=player name="Far"
spawn Pawn:APM_Mech_Pulse at 0,4 faction=player name="Pulse"
spawn Pawn:Colonist at -6,-6 name="Mechanitor"
draft "Mechanitor"
overseer "Caster" by="Mechanitor" now=true
draft "Caster"

assert pawn "Near" capacity=Moving min=0.95 max=1.05
select "Caster"
gizmo "Ultimate sacrifice"
deselect

waitfor pawn "Near" hediff=APM_Hediff_UltimateSacrifice ticks=480
assert pawn "Near" capacity=Moving min=1.2 max=1.3
assert pawn "Near" capacity=Consciousness min=1.05 max=1.15
waitfor pawn "Caster" dead ticks=120

assert pawn "Far" hediff=APM_Hediff_UltimateSacrifice expect=absent
assert pawn "Pulse" hediff=APM_Hediff_UltimateSacrifice expect=absent
assert log clean
