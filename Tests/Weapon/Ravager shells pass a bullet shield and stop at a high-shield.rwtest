rwtest 1
test "Ravager shells pass a bullet shield and stop at a high-shield" project="Apex Mechanoids" created=2026-10-01T00:00:00

requires dlc=Biotech
requires dlc=Royalty
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Ravager at -26,0 faction=player name="Ravager"
spawn Pawn:Colonist at -26,-8 name="Mechanitor"
draft "Mechanitor"
spawn Pawn:Colonist at 10,0 name="Inside"
draft "Inside"
spawn Pawn:Colonist at 20,-20 name="Covered"
draft "Covered"
give "Mechanitor" need=Food value=1
give "Inside" need=Food value=1
give "Covered" need=Food value=1
overseer "Ravager" by="Mechanitor" now=true
assert pawn "Ravager" equipment=APM_Ravager_Artillery expect=present
draft "Ravager"

spawn Thing:ShieldGeneratorBullets at 12,6 faction=Mechanoid name="Bullet shield"
select "Ravager"
gizmo "Starspewer" expect=allowed
target "Inside" expect=allowed
deselect
waitfor shots "Ravager" min=1 ticks=400
waitfor impact "Ravager" min=1 ticks=300
assert impact "Ravager" blocked min=0 max=0
assert hit "Inside" by="Ravager" min=1 max=1
despawn Thing:ShieldGeneratorBullets

spawn Thing:ShieldGeneratorMortar at 22,-16 faction=Mechanoid name="High shield"
tick 1400 note="Starspewer cooldown 22 s = 1320 ticks runs out before the second order"
select "Ravager"
gizmo "Starspewer" expect=allowed
target "Covered" expect=allowed
deselect
waitfor shots "Ravager" min=2 ticks=400
waitfor impact "Ravager" min=2 ticks=300
assert impact "Ravager" blocked min=1 max=1
assert hit "Covered" by="Ravager" min=0 max=0
assert log clean
