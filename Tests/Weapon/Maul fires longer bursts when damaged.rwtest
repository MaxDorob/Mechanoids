rwtest 1
test "Maul fires longer bursts when damaged" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Maul at 0,0 faction=player name="Fresh"
spawn Pawn:Colonist at -3,-2 name="Mechanitor A"
draft "Mechanitor A"
give "Mechanitor A" need=Food value=1
overseer "Fresh" by="Mechanitor A" now=true
equip "Fresh" thing=APM_Gun_Maul now=true
spawn Thing:Wall at 12,0 name="Wall A"

spawn Pawn:APM_Mech_Maul at 0,10 faction=player name="Worn"
spawn Pawn:Colonist at -3,8 name="Mechanitor B"
draft "Mechanitor B"
give "Mechanitor B" need=Food value=1
overseer "Worn" by="Mechanitor B" now=true
equip "Worn" thing=APM_Gun_Maul now=true
spawn Thing:Wall at 12,10 name="Wall B"

damage "Worn" amount=129 def=Blunt
assert pawn "Worn" hediff=Crack expect=present
assert pawn "Fresh" hediff=Crack expect=absent

draft "Fresh"
draft "Worn"
attack "Fresh" target="Wall A"
attack "Worn" target="Wall B"
tick 250 reason="warmup 72 + burst up to 44 = 116; the next burst no earlier than 116 + 348"
assert shots "Fresh" min=8 max=8
assert shots "Worn" min=12 max=60
undraft "Fresh"
undraft "Worn"
assert log clean
