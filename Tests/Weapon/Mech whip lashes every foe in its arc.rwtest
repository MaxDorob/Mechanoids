rwtest 1
test "Mech whip lashes every foe in its arc" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:APM_Mech_Lasher at 0,0 faction=player facing=east name="Lasher"
spawn Pawn:Colonist at -2,-3 name="Mechanitor"
draft "Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Lasher" by="Mechanitor" now=true
equip "Lasher" thing=APM_Weapon_MechWhip now=true
assert pawn "Lasher" equipment=APM_Weapon_MechWhip

spawn Pawn:Colonist at 4,0 faction=none name="Target"
spawn Pawn:Colonist at 4,1 faction=none name="Flank"
spawn Pawn:Colonist at 4,-1 name="Ally"
draft "Ally"
spawn Pawn:Colonist at 6,0 faction=none name="Far"
spawn Pawn:Colonist at -4,0 faction=none name="Behind"
assert pawn "Target" pain max=0
assert pawn "Flank" pain max=0

draft "Lasher"
attack "Lasher" target="Target"
tick 10 reason="warmup 0: one lash lands within a tick or two, the next only after the 2.6 s cooldown"
assert pawn "Target" pain min=0.05
assert pawn "Flank" pain min=0.04
assert pawn "Flank" hediff=Cut expect=present
assert pawn "Ally" pain max=0
assert pawn "Ally" hediff=Cut expect=absent
assert pawn "Far" pain max=0
assert pawn "Behind" pain max=0
undraft "Lasher"
assert log clean
