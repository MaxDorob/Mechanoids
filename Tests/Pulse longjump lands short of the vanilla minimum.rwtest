rwtest 1
test "Pulse longjump lands short of the vanilla minimum" project="Apex Mechanoids" group="Ability" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Pulse at 0,0 faction=player name="Pulse"
spawn Pawn:Colonist at -3,-2 name="Mechanitor"
draft "Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Pulse" by="Mechanitor" now=true
draft "Pulse"

select "Pulse"
gizmo "Mech longjump"
target cell=14,0 expect=refused
assert thing "Pulse" at 0,0

assert thing "Pulse" at 4,0 expect=absent
gizmo "Mech longjump"
target cell=4,0
deselect
waitfor thing "Pulse" at 4,0 ticks=300
assert thing "Pulse" at 0,0 expect=absent
undraft "Pulse"
assert log clean
