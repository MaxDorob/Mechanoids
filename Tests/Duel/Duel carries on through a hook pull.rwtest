rwtest 1
test "Duel carries on through a hook pull" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
despawn Thing:APM_DuelSpot
spawn Pawn:Colonist at 0,0 name="Duelist"
draft "Duelist"
spawn Pawn:Colonist at 4,0 faction=enemy name="Raider"
pacify "Raider"
spawn Pawn:APM_Mech_Terminus at -10,0 faction=player name="Terminus"
spawn Pawn:Colonist at -14,-4 name="Mechanitor"
draft "Mechanitor"
overseer "Terminus" by="Mechanitor" now=true
draft "Terminus"
equip "Duelist" thing=APM_Weapon_DuelistsPsySpear now=true

assert thing "Duelist" at 0,0
select "Duelist"
gizmo "The duel trial"
target "Raider"
deselect
waitfor pawn "Duelist" hediff=APM_InDuel ticks=240

select "Terminus"
gizmo "Grappling Hook"
target "Duelist"
deselect
waitfor thing APM_PawnFlyer_Hooked ticks=240
waitfor thing APM_PawnFlyer_Hooked expect=absent ticks=300

assert pawn "Duelist" hediff=APM_InDuel expect=present
assert pawn "Raider" hediff=APM_InDuel expect=present
assert pawn "Duelist" hediff=APM_DuelDraw expect=absent
assert log clean
