rwtest 1
test "Gazer emplacement names why it cannot fire" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
sky glow=1
room size=13,9 roof=false name="yard"
spawn Thing:APM_GazerEmplacement in="yard" faction=player name="emplacement"
select "emplacement"
gizmo "Sun Ray" expect=disabled reason="No power." match=equals
deselect

spawn Thing:WoodFiredGenerator in="yard" faction=player fueled=true
waitfor power "emplacement" ticks=250 expect=present
select "emplacement"
gizmo "Sun Ray" expect=disabled reason="Needs an operator." match=equals
assert text contains "APM." expect=absent
deselect
assert inspect "emplacement" contains "Status: Ready" expect=present
assert log clean
