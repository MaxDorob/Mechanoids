rwtest 1
test "Stasis container takes a mech in" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
sky glow=1
room size=13,9 roof=false name="yard"
spawn Thing:APM_MechanoidContainer_Player in="yard" faction=player name="container"
spawn Pawn:APM_Mech_Lasher in="yard" faction=player name="Lasher"
assert inspect "container" contains "Contains nobody."

select "container"
gizmo "Choose mechanoid" expect=disabled reason="No power" match=equals
deselect

spawn Thing:WoodFiredGenerator in="yard" faction=player fueled=true
waitfor power "container" ticks=250

select "container"
gizmo "Choose mechanoid"
target "Lasher"
assert text contains "APM." expect=absent
deselect
waitfor inspect "container" contains "Contains nobody." expect=absent ticks=1500
assert inspect "container" contains "Contains"
assert inspect "container" contains "unidentified" expect=absent

reload reason="the mech is kept in the container's saved innerContainer"
assert inspect "container" contains "Contains nobody." expect=absent
assert inspect "container" contains "Contains"
assert log clean
