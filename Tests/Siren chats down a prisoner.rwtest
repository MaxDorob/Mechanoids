rwtest 1
test "Siren chats down a prisoner" project="Apex Mechanoids" group="Work" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
room size=5,5 prison=true name="cell"
spawn Thing:Bed in="cell"
spawn Pawn:Colonist in="cell" name="Prisoner"
spawn Pawn:APM_Mech_Siren faction=player name="Siren"
prisoner "Prisoner" resistance=10 mode=ReduceResistance

assert prisoner "Prisoner" secure
assert pawn "Prisoner" room=PrisonCell
assert reach "Siren" to="Prisoner"
assert pawn "Prisoner" resistance min=9.9 max=10.1
work "Siren" giver=APM_SirenChatWithPrisoner on="Prisoner"
job "Siren" giver=APM_SirenChatWithPrisoner on="Prisoner" until=done ticks=3000

assert pawn "Prisoner" resistance min=7.0 max=9.8
assert log clean
