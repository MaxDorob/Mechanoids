rwtest 1
test "Pulse wave blinds flesh in its radius" project="Apex Mechanoids" group="Ability" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Pulse at 0,0 faction=player name="Pulse"
spawn Pawn:Colonist at 3,0 name="Near"
draft "Near"
spawn Pawn:Colonist at 10,0 name="Far"
draft "Far"
spawn Pawn:APM_Mech_Tinker at 0,3 faction=player name="Tin"
spawn Pawn:Colonist at -10,-6 name="Mechanitor"
draft "Mechanitor"
overseer "Pulse" by="Mechanitor" now=true
draft "Pulse"

assert pawn "Near" capacity=Sight min=0.95
assert thing "Near" at 3,0

select "Pulse"
gizmo "Pulse wave"
deselect
waitfor pawn "Near" hediff=APM_PulseWaveBlind ticks=300
assert pawn "Near" capacity=Sight max=0.21
tick 120 reason="let the wave finish past its 6.9 cell radius"

assert pawn "Far" hediff=APM_PulseWaveBlind expect=absent
assert pawn "Far" capacity=Sight min=0.95
assert pawn "Tin" hediff=APM_PulseWaveBlind expect=absent
assert log clean
