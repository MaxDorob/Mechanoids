rwtest 1
test "Mechamancer gear renders" project="Apex Mechanoids" group="Art" created=2026-09-26T00:00:00

# Commit e6006fe renamed every Mechamancer texture (MechJuggernaut* ->
# Mechamancer*) and added masks. All three pieces draw with shaderType
# CutoutComplex and useWornGraphicMask, so the "_m" texture decides which part
# of the piece takes the apparel colour; the colorGenerator picks one of four
# greys. A texture or mask that the rename missed shows as a pink square, an
# invisible piece, or a piece tinted over its whole surface.
#
# The suit ships Fat, Female, Hulk, Male and Thin bodies in north, south and
# east (west mirrors east). The helmet and the pack have one set. The pack is
# drawn as a utility pack with its own per-body offsets in east and west.
#
# Four pawns, one per facing, all in the full set. "speed paused" before the
# first spawn keeps them from walking or turning before the asks; paused after
# the spawns, they had already moved. "wear ... now=true" puts the pieces on without
# walking, so the facing given at the spawn survives.
#
# "ask": nothing here is state. Headless, every line is a skip.

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:Colonist at -6,0 name="South" facing=south
spawn Pawn:Colonist at -2,0 name="East" facing=east
spawn Pawn:Colonist at 2,0 name="North" facing=north
spawn Pawn:Colonist at 6,0 name="West" facing=west
wear "South" apparel=APM_Apparel_MechamancerSuit now=true
wear "South" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet now=true
wear "South" apparel=APM_Apparel_MechamancerPack now=true
wear "East" apparel=APM_Apparel_MechamancerSuit now=true
wear "East" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet now=true
wear "East" apparel=APM_Apparel_MechamancerPack now=true
wear "North" apparel=APM_Apparel_MechamancerSuit now=true
wear "North" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet now=true
wear "North" apparel=APM_Apparel_MechamancerPack now=true
wear "West" apparel=APM_Apparel_MechamancerSuit now=true
wear "West" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet now=true
wear "West" apparel=APM_Apparel_MechamancerPack now=true

ask "mechamancer-facings" claim="the four pawns face south, east, north and west, and each wears the mechamancer suit, helmet and backpack; the helmet sits over the head, the pack sits on the back (behind the body from the south, in front of it from the north, beside it from east and west), nothing is cut off, stretched or pink"
ask "mechamancer-masks" claim="on every piece only the panels take a grey tint and the rest keeps its painted colours; no piece is tinted over its whole surface, and no piece shows a pink or white square, in any of the four views"
assert log clean
