rwtest 1
test "Duel binds both duelists" project="Apex Mechanoids" group="Duel" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
despawn Thing:APM_DuelSpot
spawn Pawn:Colonist at 0,0 name="Duelist"
spawn Pawn:Colonist at 4,0 faction=enemy name="Raider"
equip "Duelist" thing=APM_Weapon_DuelistsPsySpear now=true
assert pawn "Duelist" equipment=APM_Weapon_DuelistsPsySpear
assert pawn "Duelist" stat=IncomingDamageFactor min=0.95 max=1.05
assert pawn "Duelist" stat=MeleeCooldownFactor min=0.95 max=1.05

draft "Duelist"
select "Duelist"
gizmo "The duel trial"
target "Raider"
assert text contains "APM" expect=absent
deselect

waitfor pawn "Raider" hediff=APM_InDuel ticks=240
assert pawn "Duelist" hediff=APM_InDuel expect=present
assert thing APM_DuelSpot expect=present
assert pawn "Duelist" stat=IncomingDamageFactor min=1.7 max=1.8
assert pawn "Duelist" stat=MeleeCooldownFactor min=0.65 max=0.75
assert log clean
