rwtest 1
test "Duel winner takes the reward" project="Apex Mechanoids" group="Duel" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
despawn Thing:APM_DuelSpot
spawn Pawn:Colonist at 0,0 name="Duelist"
spawn Pawn:Colonist at 4,0 faction=enemy name="Raider"
equip "Duelist" thing=APM_Weapon_DuelistsPsySpear now=true
assert pawn "Duelist" stat=MoveSpeed min=4.5 max=4.7

select "Duelist"
gizmo "The duel trial"
target "Raider"
deselect
speed x1
waitfor pawn "Duelist" hediff=APM_InDuel ticks=240
speed paused
assert pawn "Duelist" hediff=APM_DuelWinner expect=absent

down "Raider"
tick 5 reason="MentalStateTick notices the downed opponent on its next tick"

assert pawn "Duelist" hediff=APM_DuelWinner expect=present
assert pawn "Duelist" hediff=APM_DuelWinner severity min=0.12 max=0.13
assert pawn "Duelist" stat=MoveSpeed min=4.65 max=4.75
assert pawn "Duelist" hediff=APM_InDuel expect=absent
assert pawn "Raider" hediff=APM_InDuel expect=absent
assert thing APM_DuelSpot expect=absent
assert pawn "Raider" hediff=APM_DuelDraw expect=absent

reload reason="the winner's severity is saved and decays per day"
assert pawn "Duelist" hediff=APM_DuelWinner severity min=0.12 max=0.13
assert log clean
