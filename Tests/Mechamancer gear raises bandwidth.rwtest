rwtest 1
test "Mechamancer gear raises bandwidth" project="Apex Mechanoids" group="Apparel" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:Colonist name="Mechanitor"
spawn Pawn:Mech_Lifter faction=player name="Lifter"
overseer "Lifter" by="Mechanitor" now=true
assert pawn "Mechanitor" hediff=MechlinkImplant expect=present
assert pawn "Mechanitor" stat=MechBandwidth min=5.9 max=6.1
assert pawn "Mechanitor" stat=PainShockThreshold min=0.75 max=0.85

wear "Mechanitor" apparel=APM_Apparel_MechamancerSuit now=true
assert pawn "Mechanitor" apparel=APM_Apparel_MechamancerSuit
assert pawn "Mechanitor" stat=MechBandwidth min=29.9 max=30.1
assert pawn "Mechanitor" stat=PainShockThreshold min=0.82 max=0.88

wear "Mechanitor" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet now=true
assert pawn "Mechanitor" apparel=APM_Apparel_ArmorHelmetMechamancerHelmet
assert pawn "Mechanitor" stat=MechBandwidth min=43.9 max=44.1

wear "Mechanitor" apparel=APM_Apparel_MechamancerPack now=true
assert pawn "Mechanitor" apparel=APM_Apparel_MechamancerPack
assert pawn "Mechanitor" apparel=APM_Apparel_MechamancerSuit
assert pawn "Mechanitor" stat=MechBandwidth min=61.9 max=62.1
assert log clean
