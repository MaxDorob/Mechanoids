rwtest 1
test "Press the attack drives nearby apex mechs" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Dominus at 0,0 faction=player name="Dominus"
spawn Pawn:APM_Mech_Pulse at 5,0 faction=player name="Pulse"
spawn Pawn:APM_Mech_Pulse at 20,0 faction=player name="Far"
spawn Pawn:Mech_Scyther at 0,5 faction=player name="Scyther"
spawn Pawn:Colonist at -6,-6 name="Mechanitor"
draft "Mechanitor"
overseer "Dominus" by="Mechanitor" now=true
draft "Dominus"
spawn Pawn:APM_Mech_Dominus_Boss at 0,-20 faction=player name="Dominus boss" rolled=true
spawn Pawn:APM_Mech_Pulse at 5,-20 faction=player name="Pulse near boss"
spawn Pawn:Colonist at -6,-26 name="Boss mechanitor"
draft "Boss mechanitor"
overseer "Dominus boss" by="Boss mechanitor" now=true
draft "Dominus boss"

assert pawn "Pulse" stat=MoveSpeed min=4.2 max=4.4 expect=present
select "Dominus"
gizmo "Press The Attack" expect=allowed
select "Dominus boss"
gizmo "Press The Attack" expect=allowed
deselect

waitfor pawn "Pulse" hediff=APM_Hediff_PressTheAttack ticks=180 expect=present
assert pawn "Pulse" stat=MoveSpeed min=4.6 max=4.8 expect=present
assert pawn "Pulse" capacity=Consciousness min=1.05 max=1.15 expect=present

assert pawn "Far" hediff=APM_Hediff_PressTheAttack expect=absent
assert pawn "Scyther" hediff=APM_Hediff_PressTheAttack expect=absent

waitfor pawn "Pulse near boss" hediff=APM_Hediff_PressTheAttack_Boss ticks=180 expect=present
assert pawn "Dominus" hediff=APM_Hediff_PressTheAttack expect=present
assert pawn "Dominus boss" hediff=APM_Hediff_PressTheAttack_Boss expect=present
assert pawn "Pulse" hediff=APM_Hediff_PressTheAttack_Boss expect=absent
assert pawn "Pulse near boss" hediff=APM_Hediff_PressTheAttack expect=absent
assert log clean
