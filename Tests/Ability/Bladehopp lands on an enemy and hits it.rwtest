rwtest 1
test "Bladehopp lands on an enemy and hits it" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Mantis at 0,0 faction=player name="Mantis"
spawn Pawn:Colonist at -4,0 name="Mechanitor" gear=none
draft "Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Mantis" by="Mechanitor" now=true
draft "Mantis"

speed paused
spawn Pawn:Colonist at 5,0 faction=enemy name="Raider"
assert pawn "Raider" pain max=0 expect=present

select "Mantis"
gizmo "Bladehopp" expect=allowed
target "Raider" expect=allowed
speed x1
waitfor pawn "Raider" pain min=0.05 max=0.8 ticks=120 expect=present
assert pawn "Mantis" near="Raider" max=1.5 expect=present
assert thing "Mantis" at 5,0 expect=present
assert pawn "Mechanitor" pain max=0 expect=present
gizmo "Bladehopp" expect=disabled
deselect
assert log clean
