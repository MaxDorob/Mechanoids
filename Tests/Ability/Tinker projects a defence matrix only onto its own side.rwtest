rwtest 1
test "Tinker projects a defence matrix only onto its own side" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:APM_Mech_Tinker at 0,0 faction=player name="Tinker"
spawn Pawn:Colonist at -3,-2 name="Mechanitor" gear=none
draft "Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Tinker" by="Mechanitor" now=true
draft "Tinker"
spawn Pawn:Colonist at 5,0 name="Ally"
draft "Ally"
spawn Pawn:Colonist at 0,5 faction=enemy name="Foe"

select "Tinker"
gizmo "Defence Matrix"
target "Foe" expect=refused
assert thing MechShield expect=absent
down "Foe"

gizmo "Defence Matrix"
target "Ally"
deselect
speed x1
waitfor thing MechShield at 5,0 ticks=120
assert thing MechShield at 0,5 expect=absent
undraft "Tinker"
assert log clean
