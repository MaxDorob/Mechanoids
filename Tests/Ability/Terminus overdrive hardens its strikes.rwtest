rwtest 1
test "Terminus overdrive hardens its strikes" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Terminus faction=player name="Terminus"
spawn Pawn:Colonist name="Mechanitor"
draft "Mechanitor"
overseer "Terminus" by="Mechanitor" now=true
draft "Terminus"

assert pawn "Terminus" stat=MeleeDamageFactor min=0.95 max=1.05
assert pawn "Terminus" stat=MeleeCooldownFactor min=0.95 max=1.05
select "Terminus"
gizmo "Overdrive"

waitfor pawn "Terminus" hediff=APM_Hediff_TerminusOverdrive ticks=240
assert pawn "Terminus" stat=MeleeDamageFactor min=1.55 max=1.65
assert pawn "Terminus" stat=MeleeCooldownFactor min=0.6 max=0.7
assert pawn "Terminus" capacity=Moving min=1.2 max=1.3
gizmo "Overdrive" expect=disabled
deselect

reload reason="the overdrive is a saved hediff with a timer, and the cooldown is saved ability state"
assert pawn "Terminus" stat=MeleeDamageFactor min=1.55 max=1.65
select "Terminus"
gizmo "Overdrive" expect=disabled
deselect
assert log clean
