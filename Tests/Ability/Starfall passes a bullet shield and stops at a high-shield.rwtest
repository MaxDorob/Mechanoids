rwtest 1
test "Starfall passes a bullet shield and stops at a high-shield" project="Apex Mechanoids" created=2026-10-01T00:00:00

requires dlc=Biotech
requires dlc=Royalty
requires mod=Mortis.ApexMechanoids
despawn Thing:ShieldGeneratorBullets
despawn Thing:ShieldGeneratorMortar
spawn Thing:ShieldGeneratorBullets at 12,6 faction=Mechanoid name="Bullet shield"
spawn Thing:ShieldGeneratorMortar at 20,30 faction=Mechanoid name="High shield"
spawn Pawn:APM_Mech_Ravager at -26,0 faction=player name="Ravager"
spawn Pawn:APM_Mech_Ravager at -26,28 faction=player name="Ravager C"
spawn Pawn:Colonist at 10,0 name="Target"
draft "Target"
spawn Pawn:Colonist at 18,28 name="Target C"
draft "Target C"
spawn Pawn:Colonist at -26,-8 name="Mechanitor"
draft "Mechanitor"
spawn Pawn:Colonist at -28,20 name="Mechanitor C"
draft "Mechanitor C"
give "Target" need=Food value=1
give "Target C" need=Food value=1
give "Mechanitor" need=Food value=1
give "Mechanitor C" need=Food value=1
overseer "Ravager" by="Mechanitor" now=true
overseer "Ravager C" by="Mechanitor C" now=true
draft "Ravager"
draft "Ravager C"

assert pawn "Target" hediff=Shredded expect=absent
assert pawn "Target C" hediff=Shredded expect=absent

select "Ravager"
gizmo "Starfall"
target cell=10,0
deselect
select "Ravager C"
gizmo "Starfall"
target cell=18,28
deselect
waitfor thing APM_StarfallCarrier ticks=400
waitfor thing APM_StarfallCarrier expect=absent ticks=250
waitfor pawn "Target" hediff=Shredded ticks=300
tick 120 reason="time for split fragments to reach the shield or the target and explode"

assert casts "Ravager" ability=APM_Starfall min=1 max=1
assert casts "Ravager C" ability=APM_Starfall min=1 max=1
assert hit "Target" by="Ravager" min=1
assert pawn "Target C" hediff=Shredded expect=absent
assert hit "Target C" by="Ravager C" min=0 max=0
assert log clean
