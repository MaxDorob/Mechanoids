rwtest 1
test "Hostile Gazer shockwave wounds colonists and spares wild animals" project="Apex Mechanoids" created=2026-10-06T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Gazer at 0,0 faction=Mechanoid name="Gazer"
spawn Pawn:Colonist at 2,0 name="Colonist" gear=none
draft "Colonist"
spawn Pawn:Muffalo at -3,0 faction=none name="Muffalo"

assert pawn "Colonist" hediff=Shredded expect=absent
assert pawn "Muffalo" hediff=Shredded expect=absent

waitfor pawn "Colonist" hediff=Shredded ticks=400 expect=present
tick 60 note="the 32 tick blast wave has passed every cell of its 8.9 cell radius"

assert casts "Gazer" ability=APM_Shockwave min=1 max=1
assert hit "Colonist" by="Gazer" min=1
assert pawn "Muffalo" hediff=Shredded expect=absent
assert hit "Muffalo" by="Gazer" min=0 max=0
assert log clean
