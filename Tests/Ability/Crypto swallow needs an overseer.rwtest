rwtest 1
test "Crypto swallow needs an overseer" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Frostivus faction=player name="Keeper"
spawn Pawn:Colonist name="Fallen"
down "Fallen"

select "Keeper"
gizmo "Crypto Swallow" expect=absent
deselect
assert pawn "Fallen" hediff=APM_Hediff_Devoured expect=absent

spawn Pawn:Colonist name="Mechanitor"
overseer "Keeper" by="Mechanitor"
select "Keeper"
gizmo "Crypto Swallow" expect=allowed
target "Fallen" expect=allowed
deselect
waitfor pawn "Fallen" hediff=APM_Hediff_Devoured ticks=600 expect=present
assert pawn "Keeper" inventory=Human expect=present
assert log clean
