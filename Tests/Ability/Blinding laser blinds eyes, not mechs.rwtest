rwtest 1
test "Blinding laser blinds eyes, not mechs" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
room at -1,-3 size=9,7 door=none roof=false name="range"
spawn Pawn:APM_Mech_Tinker at 0,0 faction=player name="Tinker"
spawn Pawn:Colonist at 5,0 name="Target"
draft "Target"
spawn Pawn:Mech_Lifter at 5,2 faction=player name="Lifter"
spawn Pawn:Colonist at 0,2 name="Far"
draft "Far"
spawn Pawn:Colonist at 0,-2 name="Mechanitor"
draft "Mechanitor"
overseer "Tinker" by="Mechanitor" now=true
assert pawn "Target" capacity=Sight min=0.95
assert pawn "Far" capacity=Sight min=0.95

select "Tinker"
gizmo "Blinding Laser"
target "Target"
speed x1
deselect
waitfor pawn "Target" hediff=APM_LaserBlind ticks=180
assert pawn "Target" capacity=Sight max=0.06
assert pawn "Lifter" hediff=APM_LaserBlind expect=absent
assert pawn "Far" hediff=APM_LaserBlind expect=absent
assert pawn "Far" capacity=Sight min=0.95
assert log clean
