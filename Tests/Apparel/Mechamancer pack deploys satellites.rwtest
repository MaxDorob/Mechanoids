rwtest 1
test "Mechamancer pack deploys satellites" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
despawn Thing:APM_Mech_Satellite
spawn Pawn:Colonist name="Mechanitor"
wear "Mechanitor" apparel=APM_Apparel_MechamancerPack
assert thing APM_Mech_Satellite expect=absent

select "Mechanitor"
gizmo "summon satellite" expect=allowed
waitfor thing APM_Mech_Satellite ticks=180 expect=present
select "Mechanitor"
gizmo "summon satellite" expect=allowed
tick 180 note="second use: 60 tick warmup plus the cast job"

select "Mechanitor"
gizmo "summon satellite" expect=refused
assert text contains "APM" expect=absent
deselect
despawn Thing:APM_Mech_Satellite
assert log clean
