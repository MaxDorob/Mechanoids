rwtest 1
test "Ingestor recycles a corpse into chemfuel" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Ingestor faction=player name="Ingestor"
spawn Pawn:Colonist faction=enemy name="Body"
damage "Body" amount=999
assert pawn "Body" dead expect=present
assert thing Corpse_Human expect=present

work "Ingestor" giver=APM_IngestorProcessCorpses on=Corpse_Human expect=allowed
job "Ingestor" giver=APM_IngestorProcessCorpses on=Corpse_Human until=ended ticks=2000
assert thing Corpse_Human expect=absent
assert pawn "Ingestor" hediff=APM_AbsorbedThing expect=present

spawn Pawn:Colonist faction=enemy name="Second body"
damage "Second body" amount=999
assert thing Corpse_Human expect=present
work "Ingestor" giver=APM_IngestorProcessCorpses on=Corpse_Human expect=absent

reload note="the pending chemfuel batch is saved on the hediff"
assert pawn "Ingestor" hediff=APM_AbsorbedThing expect=present
assert log clean
