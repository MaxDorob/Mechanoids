rwtest 1
test "Tinker repairs a damaged mech" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Tinker faction=player name="Tinker"
spawn Pawn:Mech_Lifter faction=player name="Patient"
damage "Patient" amount=10 kind=Blunt
assert pawn "Patient" hediff=Crack expect=present

work "Tinker" giver=APM_TinkerRepairMech on="Patient" expect=absent

spawn Pawn:Colonist name="Mechanitor"
overseer "Tinker" by="Mechanitor"
overseer "Patient" by="Mechanitor"
assert pawn "Tinker" downed expect=absent
assert pawn "Tinker" job=SelfShutdown expect=absent
work "Tinker" giver=APM_TinkerRepairMech on="Patient" forced=true expect=allowed
job "Tinker" giver=APM_TinkerRepairMech on="Patient" forced=true until=done ticks=2500
assert pawn "Patient" hediff=Crack expect=absent
assert log clean
