rwtest 1
test "Mechamancer pack sits on a child" project="Apex Mechanoids" group="Art" created=2026-09-26T00:00:00

# Children may wear the pack: the def sets developmentalStageFilter to
# "Child, Adult". Without it vanilla falls back to adults only, and
# Pawn_ApparelTracker.Wear refuses a child with the warning "<pawn> tried to
# wear APM_Apparel_MechamancerPack but is not allowed to" - the pack is then
# not worn, so the apparel asserts fail and "assert log clean" goes red.
#
# Patch_MechamancerPackChildOffset shifts the pack's east and west draw offset
# by 0.10 for the Child body type, because the adult offsets (-0.40 / +0.40 with
# per-body corrections) put the pack beside a child's narrow back instead of on
# it. North and south are not patched; they use the def's (0,0.05) at 0.7 scale
# on every body.
#
# A child in each facing proves the pack is worn and drawn from every side; an
# adult beside the east and west child is the reference for the patched views.
#
# The apparel asserts are state and run headless. "ask" is the picture;
# headless, those lines are skips.

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:Colonist at -7,0 age=10 name="Child south" facing=south
spawn Pawn:Colonist at -4,0 age=10 name="Child east" facing=east
spawn Pawn:Colonist at -1,0 name="Adult east" facing=east
spawn Pawn:Colonist at 2,0 age=10 name="Child west" facing=west
spawn Pawn:Colonist at 5,0 name="Adult west" facing=west
spawn Pawn:Colonist at 8,0 age=10 name="Child north" facing=north
wear "Child south" apparel=APM_Apparel_MechamancerPack now=true
wear "Child east" apparel=APM_Apparel_MechamancerPack now=true
wear "Adult east" apparel=APM_Apparel_MechamancerPack now=true
wear "Child west" apparel=APM_Apparel_MechamancerPack now=true
wear "Adult west" apparel=APM_Apparel_MechamancerPack now=true
wear "Child north" apparel=APM_Apparel_MechamancerPack now=true
assert pawn "Child south" apparel=APM_Apparel_MechamancerPack expect=present
assert pawn "Child east" apparel=APM_Apparel_MechamancerPack expect=present
assert pawn "Child west" apparel=APM_Apparel_MechamancerPack expect=present
assert pawn "Child north" apparel=APM_Apparel_MechamancerPack expect=present

ask "pack-child-visible" claim="all four children visibly wear the backpack: from the south it shows behind the body, from the north it covers the back, from east and west it hangs at the back; it is not missing, cut off, pink or oversized for the child"
ask "pack-child-sides" claim="on both east and west children the backpack sits on the back, touching it, just like on the adult next to them; it does not float behind the child and does not overlap the child's front"
assert log clean
