rwtest 1
test "Regular and boss effects keep their colours" project="Apex Mechanoids" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:APM_Mech_Dominus at -12,0 faction=player name="Dominus regular" facing=south rolled=true
spawn Pawn:APM_Mech_Dominus_Boss at 12,0 faction=player name="Dominus boss" facing=south rolled=true
spawn Pawn:APM_Mech_Pulse at -9,0 faction=player name="Pulse near regular Dominus" facing=south
spawn Pawn:APM_Mech_Pulse at 9,0 faction=player name="Pulse near boss Dominus" facing=south
spawn Pawn:Colonist at -16,-4 name="Dominus regular mechanitor"
draft "Dominus regular mechanitor"
spawn Pawn:Colonist at 16,-4 name="Dominus boss mechanitor"
draft "Dominus boss mechanitor"
overseer "Dominus regular" by="Dominus regular mechanitor" now=true
overseer "Dominus boss" by="Dominus boss mechanitor" now=true
draft "Dominus regular"
draft "Dominus boss"
speed x1
select "Dominus regular"
gizmo "Press The Attack" expect=allowed
select "Dominus boss"
gizmo "Press The Attack" expect=allowed
deselect
waitfor pawn "Pulse near regular Dominus" hediff=APM_Hediff_PressTheAttack ticks=180 expect=present
waitfor pawn "Pulse near boss Dominus" hediff=APM_Hediff_PressTheAttack_Boss ticks=180 expect=present
assert pawn "Dominus regular" hediff=APM_Hediff_PressTheAttack expect=present
assert pawn "Dominus boss" hediff=APM_Hediff_PressTheAttack_Boss expect=present
ask "press-attack-halo" ticks=120 claim="each Dominus and the Pulse next to it wear a halo and animated wings from Press the Attack; the left pair is a pale steel blue-grey, the right pair is orange; the wings move; none is pink, white-boxed or missing"

speed paused
spawn Pawn:APM_Mech_Terminus at -3,-6 faction=player name="Terminus regular" facing=north
spawn Pawn:APM_Mech_Terminus_Boss at 3,-6 faction=player name="Terminus boss" facing=north rolled=true
spawn Pawn:Colonist at -6,-12 name="Terminus regular mechanitor"
draft "Terminus regular mechanitor"
spawn Pawn:Colonist at 6,-12 name="Terminus boss mechanitor"
draft "Terminus boss mechanitor"
overseer "Terminus regular" by="Terminus regular mechanitor" now=true
overseer "Terminus boss" by="Terminus boss mechanitor" now=true
draft "Terminus regular"
draft "Terminus boss"
speed x1
select "Terminus regular"
gizmo "Severing edge" expect=allowed
target cell=-3,-3 expect=allowed
select "Terminus boss"
gizmo "Severing edge" expect=allowed
target cell=3,-3 expect=allowed
deselect
ask "severing-edge" ticks=63 claim="each Terminus throws a sweeping blade of energy forward; the left blade is pale steel blue-grey, the right blade is gold; both animate while they fly"

select "Terminus regular"
gizmo "Overdrive" expect=allowed
select "Terminus boss"
gizmo "Overdrive" expect=allowed
deselect
ask "overdrive-wave" ticks=156 claim="both Terminus units throw off their cape, which flies away and fades; a wave rises around each; the left wave is pale steel blue-grey, the right wave is gold"

speed paused
spawn Pawn:APM_Mech_Celerus at -8,6 faction=player name="Celerus regular"
spawn Pawn:APM_Mech_Celerus_Boss at 8,6 faction=player name="Celerus boss" rolled=true
spawn Pawn:Colonist at -14,2 name="Celerus regular mechanitor"
draft "Celerus regular mechanitor"
spawn Pawn:Colonist at 14,2 name="Celerus boss mechanitor"
draft "Celerus boss mechanitor"
overseer "Celerus regular" by="Celerus regular mechanitor" now=true
overseer "Celerus boss" by="Celerus boss mechanitor" now=true
draft "Celerus regular"
draft "Celerus boss"
speed x1
select "Celerus regular"
gizmo "Smokescreen" expect=allowed
target cell=-8,10 expect=allowed
assert thing "Celerus boss" at 8,6 expect=present
assert thing "Celerus regular mechanitor" at -14,2 expect=present
select "Celerus boss"
gizmo "Smokescreen" expect=allowed
target cell=8,10 expect=allowed
deselect
ask "smokescreen" ticks=300 claim="a grenade arcs from each Celerus and bursts into a spreading cloud; the left grenade and cloud are pale blue-grey, the right grenade is violet and its cloud is a dark purple"
assert log clean
