rwtest 1
test "Every apex mech kind spawns armed with its own weapon" project="Apex Mechanoids" group="Wiring" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:APM_Mech_Celerus name="Celerus" rolled=true
spawn Pawn:APM_Mech_Celerus_Boss name="CelerusBoss" rolled=true
spawn Pawn:APM_Mech_Dominus name="Dominus" rolled=true
spawn Pawn:APM_Mech_Dominus_Boss name="DominusBoss" rolled=true
spawn Pawn:APM_Mech_Terminus name="Terminus" rolled=true
spawn Pawn:APM_Mech_Terminus_Boss name="TerminusBoss" rolled=true
spawn Pawn:APM_Mech_Conqueror_AR name="ConquerorAR" rolled=true
spawn Pawn:APM_Mech_Conqueror_DMR name="ConquerorDMR" rolled=true
spawn Pawn:APM_Mech_Conqueror_SMG name="ConquerorSMG" rolled=true
spawn Pawn:APM_Mech_Dynamo name="Dynamo" rolled=true
spawn Pawn:APM_Mech_Gazer name="Gazer" rolled=true
spawn Pawn:APM_Mech_Haze name="Haze" rolled=true
spawn Pawn:APM_Mech_Javelin name="Javelin" rolled=true
spawn Pawn:APM_Mech_Lasher name="Lasher" rolled=true
spawn Pawn:APM_Mech_Maul name="Maul" rolled=true
spawn Pawn:APM_Mech_Pulse name="Pulse" rolled=true
spawn Pawn:APM_Mech_Ravager name="Ravager" rolled=true
spawn Pawn:APM_Mech_Satellite name="Satellite" rolled=true
spawn Pawn:APM_Mech_Siren name="Siren" rolled=true
spawn Pawn:APM_Mech_Vassal name="Vassal" rolled=true

assert pawn "Celerus" equipment=APM_Weapon_CelerusVoltana
assert pawn "CelerusBoss" equipment=APM_Weapon_CelerusApexVoltana
assert pawn "Dominus" equipment=APM_Weapon_DominusMechlance
assert pawn "DominusBoss" equipment=APM_Weapon_DominusApexMechlance
assert pawn "Terminus" equipment=APM_Weapon_TerminusExoblade
assert pawn "TerminusBoss" equipment=APM_Weapon_TerminusApexExoblade
assert pawn "ConquerorAR" equipment=APM_Gun_Conqueror_AR
assert pawn "ConquerorDMR" equipment=APM_Gun_Conqueror_DMR
assert pawn "ConquerorSMG" equipment=APM_Gun_Conqueror_SMG
assert pawn "Dynamo" equipment=APM_Gun_EMP_Impactor
assert pawn "Gazer" equipment=APM_Gazer_Laser
assert pawn "Haze" equipment=APM_Haze_BeamGun
assert pawn "Javelin" equipment=APM_Gun_JavelinRocketLauncher
assert pawn "Lasher" equipment=APM_Weapon_MechWhip
assert pawn "Maul" equipment=APM_Gun_Maul
assert pawn "Pulse" equipment=APM_Gun_Pulse_Shotgun
assert pawn "Ravager" equipment=APM_Ravager_Artillery
assert pawn "Satellite" equipment=APM_Gun_Satellite
assert pawn "Siren" equipment=APM_Siren_ChargeEmitter
assert pawn "Vassal" equipment=APM_Gun_Vassal_SwordRifle
assert log clean
