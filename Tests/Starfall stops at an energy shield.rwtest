rwtest 1
test "Starfall stops at an energy shield" project="Apex Mechanoids" group="Ability" created=2026-10-01T00:00:00

requires dlc=Biotech
requires dlc=Royalty
requires mod=Mortis.ApexMechanoids
despawn Thing:ShieldGeneratorBullets
spawn Thing:ShieldGeneratorBullets at 12,6 name="Near shield"
spawn Thing:ShieldGeneratorBullets at 28,-12 name="Far shield"
spawn Pawn:APM_Mech_Ravager at -26,0 faction=player name="Ravager"
spawn Pawn:APM_Mech_Ravager at -28,-22 faction=player name="Ravager B"
spawn Pawn:Colonist at 10,0 name="Target"
spawn Pawn:Colonist at 18,-22 name="Target B"
spawn Pawn:Colonist at 12,-22 name="Guarded"
spawn Pawn:Colonist at -26,-8 name="Mechanitor"
spawn Pawn:Colonist at -28,-28 name="Mechanitor B"
give "Target" need=Food value=1
give "Target B" need=Food value=1
give "Guarded" need=Food value=1
give "Mechanitor" need=Food value=1
give "Mechanitor B" need=Food value=1
draft "Target"
draft "Target B"
draft "Guarded"
draft "Mechanitor"
draft "Mechanitor B"
overseer "Ravager" by="Mechanitor" now=true
overseer "Ravager B" by="Mechanitor B" now=true
draft "Ravager"
draft "Ravager B"

assert pawn "Target" hediff=Shredded expect=absent
assert pawn "Target B" hediff=Shredded expect=absent
assert pawn "Guarded" hediff=Shredded expect=absent

select "Ravager"
gizmo "Starfall"
target cell=10,0
deselect
select "Ravager B"
gizmo "Starfall"
target cell=18,-22
deselect
waitfor thing APM_StarfallCarrier ticks=400
waitfor thing APM_StarfallCarrier expect=absent ticks=250
tick 120 reason="time for split fragments to reach the shield or the target and explode"

assert casts "Ravager" ability=APM_Starfall min=1 max=1
assert casts "Ravager B" ability=APM_Starfall min=1 max=1
assert pawn "Target" hediff=Shredded expect=absent
assert hit "Target" by="Ravager" min=0 max=0
assert pawn "Target B" hediff=Shredded expect=absent
assert hit "Target B" by="Ravager B" min=0 max=0
assert pawn "Guarded" hediff=Shredded expect=absent
assert hit "Guarded" by="Ravager B" min=0 max=0
assert log clean
