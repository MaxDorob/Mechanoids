rwtest 1
test "Weapons grant and take their abilities" project="Apex Mechanoids" group="Weapon" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:Colonist at 0,0 name="Wielder"
draft "Wielder"
select "Wielder"
gizmo "Severing edge" expect=absent

equip "Wielder" thing=APM_Weapon_SeveringBlade now=true
assert pawn "Wielder" equipment=APM_Weapon_SeveringBlade
assert ability APM_SeveringEdge on "Wielder" range min=4.4 max=5.4
gizmo "Severing edge"
target cell=3,0
tick 60 reason="0.3 s warmup of the severing edge"
gizmo "Skip" expect=absent

equip "Wielder" thing=APM_Weapon_Skipblade now=true
assert pawn "Wielder" equipment=APM_Weapon_Skipblade
assert ability APM_SkipbladeBlink on "Wielder" range min=17.4 max=18.4
gizmo "Severing edge" expect=absent
gizmo "Skip"
target cell=8,0
tick 60 reason="the skip resolves after its short warmup"
assert text contains "APM" expect=absent
assert log clean
