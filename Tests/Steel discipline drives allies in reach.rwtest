rwtest 1
test "Steel discipline drives allies in reach" project="Apex Mechanoids" group="Ability" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
speed paused
spawn Pawn:APM_Mech_Vassal at 0,0 faction=player name="Vassal" gear=none
spawn Pawn:Colonist at 4,0 age=30 name="Near"
spawn Pawn:Colonist at 15,0 age=30 name="Far"
spawn Pawn:Colonist at 0,3 faction=enemy name="Raider"
pacify "Raider"
draft "Near"
draft "Far"
spawn Pawn:Colonist at -14,0 name="Mechanitor"
draft "Mechanitor"
overseer "Vassal" by="Mechanitor" now=true

assert pawn "Near" stat=MoveSpeed min=4.5 max=4.7
assert thing "Near" at 4,0

speed x1
select "Vassal"
gizmo "Steel Discipline"
deselect

waitfor pawn "Vassal" hediff=APM_Hediff_SteelDiscipline ticks=240
assert pawn "Near" hediff=APM_Hediff_SteelDiscipline expect=present
assert pawn "Near" stat=MoveSpeed min=4.8 max=5.0
assert pawn "Near" thought=APM_Thought_InspiredByDiscipline expect=present
assert pawn "Near" thought=APM_Thought_InspiredByDiscipline mood min=7.5 max=8.5

assert pawn "Far" hediff=APM_Hediff_SteelDiscipline expect=absent
assert pawn "Far" stat=MoveSpeed min=4.5 max=4.7
assert pawn "Raider" hediff=APM_Hediff_SteelDiscipline expect=absent

reload reason="the buff is a saved hediff with a Disappears timer"
assert pawn "Near" hediff=APM_Hediff_SteelDiscipline expect=present
assert pawn "Near" stat=MoveSpeed min=4.8 max=5.0
assert log clean

assert statpart "Near" stat=WorkSpeedGlobal from=APM_Hediff_SteelDiscipline offset min=0.14 max=0.16
