rwtest 1
test "Bladehopp lands on an enemy and hits it" project="Apex Mechanoids" group="Ability" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Mantis at 0,0 faction=player name="Mantis"
spawn Pawn:Colonist at -4,0 name="Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Mantis" by="Mechanitor"
draft "Mantis"

speed paused
spawn Pawn:Colonist at 5,0 faction=enemy name="Raider"
assert pawn "Raider" pain max=0

select "Mantis"
gizmo "Bladehopp"
target "Raider"
speed x1
waitfor pawn "Raider" pain min=0.05 max=0.8 ticks=120
assert pawn "Mantis" near="Raider" max=1.5
assert thing "Mantis" at 5,0
assert pawn "Mechanitor" pain max=0
gizmo "Bladehopp" expect=disabled
deselect
assert log clean
