rwtest 1
test "Shield charge stuns foes where it lands" project="Apex Mechanoids" group="Ability" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Aegis at 0,0 faction=player name="Aegis"
spawn Pawn:Colonist at -4,0 name="Mechanitor"
draft "Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Aegis" by="Mechanitor"
draft "Aegis"
spawn Thing:Sandbags at 3,3 name="sandbags"

select "Aegis"
gizmo "Shield Charge"
target cell=3,3 expect=refused

speed paused
spawn Pawn:Colonist at 5,0 faction=none name="Raider"
spawn Pawn:Colonist at 5,-1 faction=player name="Ally"
draft "Ally"
gizmo "Shield Charge"
target "Raider"
speed x1
waitfor thing "Aegis" at 5,0 ticks=120
assert stun "Raider" ticks min=280 max=300
assert stun "Ally" expect=absent
assert pawn "Ally" pain max=0
gizmo "Shield Charge" expect=disabled
deselect
assert log clean
