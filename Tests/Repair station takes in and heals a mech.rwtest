rwtest 1
test "Repair station takes in and heals a mech" project="Apex Mechanoids" group="Building" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
sky glow=1
room size=13,9 roof=false name="yard"
spawn Thing:SolarGenerator in="yard" faction=player
spawn Thing:APM_RepairStation_Small in="yard" faction=player name="station"
spawn Pawn:Mech_Lifter in="yard" faction=player name="Repairee"
waitfor power "station" ticks=250

damage "Repairee" amount=10 def=Blunt
assert pawn "Repairee" hediff=Crack expect=present

select "station"
gizmo "Insert mech..."
menu "Repairee"
assert text contains "APM_" expect=absent
deselect
waitfor inspect "station" contains "Repairing" ticks=1500
waitfor pawn "Repairee" hediff=Crack expect=absent ticks=2500

select "station"
gizmo "Insert mech..."
menu "Repairee" expect=absent
menu "No mechs available." expect=disabled
assert log clean
