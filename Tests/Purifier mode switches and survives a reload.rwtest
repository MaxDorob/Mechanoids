rwtest 1
test "Purifier mode switches and survives a reload" project="Apex Mechanoids" group="Building" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Thing:APM_Building_ToxicPurifier faction=player name="purifier"
assert inspect "purifier" contains "0 / 15"

select "purifier"
gizmo "Mode: Wastepacks only" expect=absent
gizmo "Mode: Ground over wastepacks"
menu "Wastepacks only"
assert text contains "APM_" expect=absent
select "purifier"
gizmo "Mode: Ground over wastepacks" expect=absent
gizmo "Mode: Wastepacks only"
menu "Wastepacks only"
deselect

reload reason="the purifier mode is saved on the comp"
select "purifier"
gizmo "Mode: Ground over wastepacks" expect=absent
gizmo "Mode: Wastepacks only"
menu "Wastepacks only"
deselect
assert log clean
