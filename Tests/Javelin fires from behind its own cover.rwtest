rwtest 1
test "Javelin fires from behind its own cover" project="Apex Mechanoids" group="Weapon" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Thing:Wall at 3,-3
spawn Thing:Wall at 3,-2
spawn Thing:Wall at 3,-1
spawn Thing:Wall at 3,0
spawn Thing:Wall at 3,1
spawn Thing:Wall at 3,2
spawn Thing:Wall at 3,3
spawn Thing:Wall at -2,-3
spawn Thing:Wall at -2,-2
spawn Thing:Wall at -2,-1
spawn Thing:Wall at -2,0
spawn Thing:Wall at -2,1
spawn Thing:Wall at -2,2
spawn Thing:Wall at -2,3
spawn Thing:Wall at -1,-3
spawn Thing:Wall at 0,-3
spawn Thing:Wall at 1,-3
spawn Thing:Wall at 2,-3
spawn Thing:Wall at -1,3
spawn Thing:Wall at 0,3
spawn Thing:Wall at 1,3
spawn Thing:Wall at 2,3

spawn Pawn:APM_Mech_Javelin at 0,0 faction=player name="Javelin"
spawn Pawn:Colonist at -1,-2 name="Mechanitor"
give "Mechanitor" need=Food value=1
draft "Mechanitor"
overseer "Javelin" by="Mechanitor" now=true
equip "Javelin" thing=APM_Gun_JavelinRocketLauncher now=true
assert pawn "Javelin" equipment=APM_Gun_JavelinRocketLauncher

spawn Pawn:Colonist at 20,0 name="Dummy A"
draft "Dummy A"

spawn Thing:Wall at -2,10
spawn Thing:Wall at -1,10
spawn Thing:Wall at 0,10
spawn Thing:Wall at 1,10
spawn Thing:Wall at 2,10
spawn Pawn:Colonist at 0,20 name="Dummy B"
draft "Dummy B"

assert pawn "Dummy A" hediff=APM_Hediff_JavelinMissileLock expect=absent
assert pawn "Dummy A" pain max=0

draft "Javelin"
attack "Javelin" target="Dummy A"
waitfor jobhistory "Javelin" job=AttackStatic ticks=60
waitfor shots "Javelin" min=1 ticks=600
waitfor pawn "Dummy A" hediff=APM_Hediff_JavelinMissileLock ticks=600
assert pawn "Dummy A" pain min=0.1
undraft "Javelin"

tick 450 reason="cooldown 7.4 s = 444 ticks from the east shot runs out before the north order"
draft "Javelin"
select "Javelin"
gizmo "Javelin rocket launcher"
target "Dummy B" expect=refused reason="Cannot hit target"
deselect
attack "Javelin" target="Dummy B"
tick 600 reason="the same 244 tick warmup-plus-flight the east shot needed, with the same margin"
assert shots "Javelin" min=0 max=0
assert pawn "Dummy B" hediff=APM_Hediff_JavelinMissileLock expect=absent
undraft "Javelin"
assert log clean
