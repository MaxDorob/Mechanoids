rwtest 1
test "Crypto swallow takes a downed pawn" project="Apex Mechanoids" group="Ability" created=2026-09-26T00:00:00

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Frostivus faction=player name="Frost"
spawn Pawn:Colonist faction=enemy name="Raider"
spawn Pawn:Colonist name="Mechanitor"
draft "Mechanitor"
overseer "Frost" by="Mechanitor" now=true

select "Frost"
gizmo "Crypto Swallow"
target "Raider" expect=refused
deselect
assert pawn "Raider" hediff=APM_Hediff_Devoured expect=absent

down "Raider"
assert pawn "Raider" downed
select "Frost"
gizmo "Crypto Swallow"
target "Raider"
deselect
waitfor pawn "Raider" hediff=APM_Hediff_Devoured ticks=600
assert pawn "Frost" inventory=Human

reload reason="the swallowed pawn lives in a saved inventory with a saved hediff"
assert pawn "Frost" inventory=Human
assert pawn "Raider" hediff=APM_Hediff_Devoured expect=present
assert log clean
