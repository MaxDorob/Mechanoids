rwtest 1
test "Tinker repairs a mech on its own" project="Apex Mechanoids" group="Work" created=2026-09-30T00:00:00

# The promise: a colony Tinker repairs a damaged friendly mech without being
# told to. No "work" and no "job" line here - nothing hands the Tinker its job.
#
# The route a colony Tinker takes (ThinkTrees_Tinker.xml): work mode Work ->
# JobGiver_Work with emergency=true -> APM_TinkerRepairMech (emergency,
# priorityInType 240, above repair building) -> JobDriver_ApexRepairMech.
# JobGiver_Tinker is NOT on this route: it sits under "Non-player fallback"
# with invert=true and serves Tinkers of other factions only.
#
# JobGiver_Work asks unforced, and unforced TinkerRepairUtility.CanRepairMechNow
# (:175) wants CompMechRepairable.autoRepair on the patient - the "auto repair"
# toggle, which vanilla leaves false. A player who wants autonomous repair
# switches it on; the "comp" line does the same. Without it the Tinker leaves
# the mech alone, which "Tinker leaves a mech alone without auto repair" pins.
#
# Two reads, each for one half of the claim:
#   jobhistory - the Tinker STARTED APM_RepairMech by itself (the decision)
#   Crack gone - on exactly this patient (the effect). FindRepairableMech
#                takes the closest candidate, so a damaged mech left standing
#                by an earlier failed test could draw the Tinker away; then the
#                first line is green and the second one red, and says so.
# Both are waitfor lines: they count game ticks, stop the moment they hold and
# report the tick they held at. 2500 is a budget, not a guess at the timing -
# the first green run's "held at" is the number to keep an eye on.
#
# The Tinker stands undrafted (a drafted pawn gets no work) with its overseer
# at once; Tinker 2 + Lifter 1 bandwidth of a fresh mechlink's 6. A colony mech
# joins the default control group in work mode Work - if the first run shows
# the Tinker wandering instead, the work mode is the suspect.
#
# Damage: Blunt 10 on the core part of a Lifter lands as Crack, far from lethal.

requires dlc=Biotech
requires mod=Mortis.ApexMechanoids
spawn Pawn:APM_Mech_Tinker at 0,0 faction=player name="Tinker"
spawn Pawn:Mech_Lifter at 6,0 faction=player name="Patient"
spawn Pawn:Colonist at -4,0 name="Mechanitor"
give "Mechanitor" need=Food value=1
overseer "Tinker" by="Mechanitor" now=true
overseer "Patient" by="Mechanitor" now=true
comp "Patient" type=CompMechRepairable autoRepair=true
damage "Patient" amount=10 def=Blunt
assert pawn "Patient" hediff=Crack expect=present

waitfor jobhistory "Tinker" job=APM_RepairMech ticks=2500
waitfor pawn "Patient" hediff=Crack expect=absent ticks=2500
assert log clean
